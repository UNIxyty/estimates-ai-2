# ---------------------------------------------------------------------------------------------
# Estimates AI Agent — copy to .env and fill in. Values here reach the containers via env_file
# (not shell interpolation), so an exported shell variable cannot shadow them — except the few
# marked [interpolated]. Run ./scripts/check-env.sh before `docker compose up`.
# ---------------------------------------------------------------------------------------------

# --- App / network ----------------------------------------------------------------------------
# [interpolated] The ONE published port (web). Your cloudflared tunnel points at http://127.0.0.1:APP_PORT
APP_PORT=8088
# [interpolated] Bind address for that port. Keep 127.0.0.1 when the tunnel runs on the host.
APP_BIND=127.0.0.1
# Public URL users open (used in invite/reset links and cookies: https → Secure cookies)
APP_URL=https://estimates.example.com
# IANA time zone for day/month boundaries in usage and budget (e.g. Europe/Riga)
APP_TIMEZONE=Europe/Riga
# Random 64+ char secrets:  openssl rand -hex 32
SESSION_SECRET=change-me-openssl-rand-hex-32
INTERNAL_TOKEN=change-me-openssl-rand-hex-32
# [interpolated] Worker memory limit (see README: measured minimum 1 GB, 2 GB recommended)
WORKER_MEM_LIMIT=2g
WORKER_CONCURRENCY=3

# --- Database (Postgres 16 + pgvector, internal only) -----------------------------------------
POSTGRES_USER=estimates
POSTGRES_PASSWORD=change-me
POSTGRES_DB=estimates
# Deliberately NOT named DATABASE_URL (an exported DATABASE_URL in your shell can't shadow it).
ESTIMATES_DATABASE_URL=postgresql://estimates:change-me@db:5432/estimates

# --- AWS Bedrock (Converse API) ----------------------------------------------------------------
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Model per tier: eu.* inference profiles only (never global.* or us.*); editable later on /settings/routing.
# Verified in eu-north-1 on 2026-10-01: Sonnet 5 / Opus 4.7+ are not enabled for this account yet.
# List what your region offers:  docker compose run --rm worker python -m app.bedrock_models
BEDROCK_MODEL_FAST=eu.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_STANDARD=eu.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ADVANCED=eu.anthropic.claude-opus-4-6-v1
# Multilingual embeddings, 1024 dims (matches the pgvector vector(1024) columns)
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_PROMPT_CACHE=true
# Set to false to run fully deterministic (no model calls at all)
LLM_ENABLED=true

# --- Cost safety ---------------------------------------------------------------------------------
# Per-run safety cap in USD: a run that would exceed it pauses and asks (Continue adds this amount again)
RUN_COST_CAP_USD=2
# Seconds during which an Allow/Deny on a permission card can be undone
UNDO_SECONDS=10
PERMISSION_CARD_MINUTES=30

# --- Email (Resend) ------------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Estimates <estimates@your-domain.com>

# --- Web search for supplier prices ----------------------------------------------------------------
# brave | tavily
WEB_SEARCH_PROVIDER=tavily
BRAVE_API_KEY=
TAVILY_API_KEY=
# Logged in the usage ledger per search call (USD)
# Supplier allowlist for web prices: domain[:COUNTRY], comma-separated. Only these shops are searched and
# fetched; a shop that blocks automated clients (e.g. elektrika.lv answers 403) yields no prices.
WEB_SEARCH_DOMAINS=elektrika.lv:LV,prof.lv:LV,bpgroup.lv:LV
WEB_SEARCH_UNIT_COST_USD=0.005
WEB_USER_AGENT=EstimatesAgent/1.0 (+https://estimates.example.com; price lookup; respects robots.txt)

# --- First admin (python -m app.seed_admin) ------------------------------------------------------
FIRST_ADMIN_EMAIL=you@your-domain.com
FIRST_ADMIN_NAME=Admin
# Optional: set a password directly instead of emailing an invite link (≥10 chars, contains a number)
FIRST_ADMIN_PASSWORD=

# --- Optional: cloudflared inside compose (docker compose --profile tunnel up -d) ----------------
TUNNEL_TOKEN=

# --- Misc ------------------------------------------------------------------------------------------
LOG_LEVEL=INFO
# [interpolated] Baked into both images; shown in the footer and /api/health
# BUILD_HASH is passed at build time: BUILD_HASH=$(git rev-parse --short HEAD) docker compose build
