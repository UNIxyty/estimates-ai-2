# ---- web service (merged into the root .env.example by the lead) ----
# Postgres (deliberately NOT DATABASE_URL, so a shell-exported DATABASE_URL cannot shadow it)
ESTIMATES_DATABASE_URL=postgresql://estimates:change-me@db:5432/estimates
# 32+ random bytes; HMAC key for session ids (openssl rand -hex 32)
SESSION_SECRET=change-me
# Public URL (https → Secure cookies); used in invite/reset links
APP_URL=https://estimates.example.com
# Internal worker API (never published)
WORKER_URL=http://worker:8000
INTERNAL_TOKEN=change-me
# Shared files volume (mounted in web and worker)
DATA_DIR=/data/files
# Per-run cost cap in USD (cost_cap card "continue" raises the cap by this amount)
RUN_COST_CAP_USD=2
# Undo window for permission Allow/Deny, in seconds
UNDO_SECONDS=10
# Baked in at build time via `docker build --build-arg BUILD_HASH=$(git rev-parse --short HEAD)`
BUILD_HASH=dev
# Default model ids per tier (routing settings fall back to these until an admin saves routing)
BEDROCK_MODEL_FAST=eu.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_STANDARD=eu.anthropic.claude-sonnet-5-5
BEDROCK_MODEL_ADVANCED=eu.anthropic.claude-opus-5-5
# Optional: postgres pool size for web (default 10)
# DB_POOL_MAX=10
